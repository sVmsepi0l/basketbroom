# visual studio 2015 user specific files
.vs/

# compiled object files
*.slo
*.lo
*.o
*.obj
!SourceArt/**/*.obj

# precompiled headers
*.gch
*.pch

# compiled dynamic libraries
*.so
*.dylib
*.dll

# fortran module files
*.mod

# compiled static libraries
*.lai
*.la
*.a
*.lib

# executables
*.exe
*.out
*.app
*.ipa

# these project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# precompiled assets
SourceArt/**/*.png
SourceArt/**/*.tga
!SourceArt/Textures/T_BB_Basalt_Albedo.png
!SourceArt/Promo/**/*.png

# binary files
Binaries/*
Plugins/**/Binaries/*

# builds
Build/*

# whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# don't ignore icon files in build
!Build/**/*.ico

# built data for maps
*_BuiltData.uasset

# configuration files generated by the editor
Saved/*

# compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# cache files for the editor to use
DerivedDataCache/*

# local tooling, editor state and extracted licensed reference files
.local/
**/__pycache__/
**/Saved/
**/Intermediate/
**/DerivedDataCache/
**/Binaries/
*.log

# reproducible local UE5.8 template dependencies; stage_skeletal_rider.py copies
# the exact installed stock packages. owned animation/materials stay in the mod.
/DevelopmentHarness/Content/Characters/Mannequins/

# temporarily hiding of presspacket assets for packaging purposes
**/PressPacket/

# generated gameplay videos stay local, including exports under Docs.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
